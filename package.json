{
  "name": "chronicle-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:client",
    "dev:client": "cd apps/client && npm run dev",
    "dev:server": "cd apps/server && npm run dev",
    "build": "npm run build:shared && npm run build:client && npm run build:server",
    "build:shared": "cd packages/shared-types && npm run build",
    "build:client": "cd apps/client && npm run build",
    "build:server": "cd apps/server && npm run build",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "type-check": "npm run type-check:client && npm run type-check:server"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.5.0"
}